{
  "rewrites": [
    { "source": "/((?!assets/|registerSW.js|manifest.webmanifest|sw.js|workbox-|favicon|robots.txt|sitemap.xml).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
